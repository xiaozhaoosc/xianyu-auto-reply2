# ===========================================
# 闲鱼自动回复系统 - 环境变量配置示例
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改 .env 中的配置值
# 3. ⚠️  .env 文件包含敏感信息，切勿提交到 Git！

# ===========================================
# MySQL 数据库配置
# ===========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=xianyu
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=xianyu_data

# ===========================================
# Redis 配置
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ===========================================
# JWT 配置
# ===========================================
# 说明：JWT_SECRET_KEY 由数据库统一托管（首次启动自动生成并持久化到 xy_system_settings）
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# 管理员账号配置
# ===========================================
ADMIN_PASSWORD=your_admin_password_here

# ===========================================
# 服务端口配置
# ===========================================
BACKEND_WEB_PORT=8089
WEBSOCKET_PORT=8090
SCHEDULER_PORT=8091

# ===========================================
# CORS 配置
# ===========================================
# * 表示允许所有来源，生产环境建议指定具体域名
CORS_ORIGINS=*

# ===========================================
# 服务间通信 URL
# ===========================================
WEBSOCKET_SERVICE_URL=http://localhost:8090
SCHEDULER_SERVICE_URL=http://localhost:8091

# ===========================================
# 运行时配置
# ===========================================
ENVIRONMENT=development
BROWSER_HEADLESS=true
LOG_LEVEL=INFO
SQL_ECHO=true
TZ=Asia/Shanghai

# ===========================================
# 数据库连接池配置（可选）
# ===========================================
# 账号数量较大时可调优；不配置则使用代码内置默认值
# 重要：DB_POOL_SIZE + DB_MAX_OVERFLOW 不应超过 MySQL 的 max_connections
# DB_POOL_SIZE=40
# DB_MAX_OVERFLOW=60
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true
# DB_POOL_USE_LIFO=true
# DB_CONNECT_TIMEOUT=10

# ===========================================
# 前端配置（可选）
# ===========================================
# 前端公网访问地址（用于生成前端页面分享链接）
# FRONTEND_PUBLIC_URL=http://localhost:9000

# Backend-Web服务的公网访问地址（用于生成文件URL）
# BACKEND_WEB_PUBLIC_URL=http://localhost:8089

# ===========================================
# 自动启动采集任务（可选）
# ===========================================
# AUTO_START_CRAWL_JOBS=false
